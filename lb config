#!/usr/bin/env bash
# LoriOS builder: Debian 13 (trixie) + XFCE, Windows-like look, boot splash with logo and spinner
# Keep this script together with the folder plymouth-lorios/ and wallpaper.png
# Run on Debian/Ubuntu with internet:  sudo bash build-lorios.sh
set -euo pipefail
SRC="$(cd "$(dirname "$0")" && pwd)"

apt update
apt install -y live-build debootstrap squashfs-tools xorriso

mkdir -p ~/lorios && cd ~/lorios
lb clean --purge || true

lb config \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main non-free-firmware" \
  --apt-recommends false \
  --binary-images iso \
--bootloader syslinux \
--debian-installer none \
  --iso-application "LoriOS" \
  --iso-volume "LoriOS" \
  --image-name "LoriOS" \
  --bootappend-live "boot=live components quiet splash username=lori hostname=lorios locales=ru_RU.UTF-8 keyboard-layouts=us,ru" \
  --compression xz

mkdir -p config/package-lists
cat > config/package-lists/lorios.list.chroot <<'PKG'
live-boot
live-config
live-config-systemd
linux-image-amd64
firmware-linux-free
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-misc-nonfree
wpasupplicant
wireless-regdb
xserver-xorg-core
xserver-xorg-input-libinput
xserver-xorg-video-all
xserver-xorg-video-nouveau
libgl1-mesa-dri
libglx-mesa0
plymouth
lightdm
lightdm-gtk-greeter
xfce4-session
xfce4-settings
dbus-x11
libgtk-3-bin
xfce4-panel
xfce4-whiskermenu-plugin
xfce4-terminal
xfdesktop4
xfwm4
xfconf
thunar
thunar-volman
gvfs
gvfs-backends
udisks2
calamares
calamares-settings-debian
sudo
grub-pc
os-prober
cryptsetup
rsync
parted
dosfstools
e2fsprogs
ntfs-3g
mousepad
ristretto
network-manager-gnome
pulseaudio
pavucontrol
galculator
audacious
audacious-plugins
gstreamer1.0-plugins-good
xfce4-taskmanager
lshw-gtk
alsa-utils
alsa-ucm-conf
firmware-sof-signed
xfce4-pulseaudio-plugin
firefox-esr
firefox-esr-l10n-ru
arc-theme
papirus-icon-theme
fonts-noto-core
locales
console-setup
PKG

# --- Boot splash (Plymouth): logo + spinning circle ---
T=config/includes.chroot/usr/share/plymouth/themes/lorios
mkdir -p "$T"
cp "$SRC"/plymouth-lorios/* "$T"/

mkdir -p config/hooks/normal
cat > config/hooks/normal/0200-plymouth.hook.chroot <<'HOOK'
#!/bin/sh
plymouth-set-default-theme lorios
update-initramfs -u
HOOK

# --- Wallpaper + login screen background ---
B=config/includes.chroot/usr/share/backgrounds
mkdir -p "$B"
cp "$SRC/wallpaper.png" "$B/lorios.png"

mkdir -p config/includes.chroot/etc/lightdm
cat > config/includes.chroot/etc/lightdm/lightdm-gtk-greeter.conf <<'CONF'
[greeter]
background=/usr/share/backgrounds/lorios.png
theme-name=Arc
icon-theme-name=Papirus
CONF

mkdir -p config/includes.chroot/etc/skel/.config/autostart
cat > config/includes.chroot/etc/skel/.config/autostart/lorios-wallpaper.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=LoriOS wallpaper
Exec=sh -c "sleep 3; for p in $(xfconf-query -c xfce4-desktop -l | grep last-image); do xfconf-query -c xfce4-desktop -p $p -s /usr/share/backgrounds/lorios.png; done"
DESK

# --- Windows-like theme ---
mkdir -p config/includes.chroot/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
cat > config/includes.chroot/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Arc"/>
    <property name="IconThemeName" type="string" value="Papirus"/>
  </property>
</channel>
XML

# --- Desktop icons: My Computer + Trash ---
mkdir -p config/includes.chroot/etc/skel/Desktop
cat > config/includes.chroot/etc/skel/Desktop/mycomputer.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=My Computer
Name[ru]=Мой компьютер
Comment=Диски и папки
Exec=thunar computer:///
Icon=computer
Terminal=false
Categories=System;
DESK

cat > config/includes.chroot/etc/skel/Desktop/trash.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=Trash
Name[ru]=Корзина
Comment=Удалённые файлы
Exec=thunar trash:///
Icon=user-trash
Terminal=false
Categories=System;
DESK

# trust launchers on first login + make sound audible on first login
cat > config/includes.chroot/etc/skel/.config/autostart/lorios-trust.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=LoriOS trust launchers
Exec=sh -c "sleep 2; for f in $HOME/Desktop/*.desktop; do chmod +x \"$f\"; gio set \"$f\" metadata::trusted true; done"
DESK

cat > config/includes.chroot/etc/skel/.config/autostart/lorios-audio.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=LoriOS audio defaults
Exec=sh -c "[ -f $HOME/.config/lorios-audio-done ] && exit 0; sleep 5; for c in Master Speaker Headphone PCM Front; do amixer -q sset $c unmute 2>/dev/null; amixer -q sset $c 80% 2>/dev/null; done; pactl set-sink-mute @DEFAULT_SINK@ 0; pactl set-sink-volume @DEFAULT_SINK@ 80%; touch $HOME/.config/lorios-audio-done"
DESK

cat > config/includes.chroot/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="desktop-icons" type="empty">
    <property name="style" type="int" value="2"/>
    <property name="file-icons" type="empty">
      <property name="show-home" type="bool" value="false"/>
      <property name="show-filesystem" type="bool" value="false"/>
      <property name="show-trash" type="bool" value="false"/>
      <property name="show-removable" type="bool" value="true"/>
    </property>
  </property>
</channel>
XML

cat > config/hooks/normal/0300-desktop.hook.chroot <<'HOOK'
#!/bin/sh
chmod +x /etc/skel/Desktop/*.desktop
chmod +x /usr/local/bin/lorios-devmgr
HOOK

# --- Start button icon + Windows-like bottom panel ---
for SZ in 48 64 256; do
  mkdir -p "config/includes.chroot/usr/share/icons/hicolor/${SZ}x${SZ}/apps"
  cp "$SRC/start-icon/lorios-start-${SZ}.png" "config/includes.chroot/usr/share/icons/hicolor/${SZ}x${SZ}/apps/lorios-start.png"
done

PANEL=config/includes.chroot/etc/skel/.config/xfce4
mkdir -p "$PANEL/panel"
cat > "$PANEL/panel/whiskermenu-1.rc" <<'RC'
button-icon=lorios-start
button-single-row=false
show-button-title=false
show-button-icon=false
RC

cat > "$PANEL/xfconf/xfce-perchannel-xml/xfce4-panel.xml" <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=10;x=0;y=0"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="length" type="uint" value="100"/>
      <property name="size" type="uint" value="44"/>
      <property name="icon-size" type="uint" value="32"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="7"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="6"/>
        <value type="int" value="5"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="whiskermenu"/>
    <property name="plugin-7" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="16000000007.desktop"/>
      </property>
    </property>
    <property name="plugin-2" type="string" value="tasklist">
      <property name="grouping" type="uint" value="1"/>
    </property>
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-4" type="string" value="systray"/>
    <property name="plugin-6" type="string" value="pulseaudio"/>
    <property name="plugin-5" type="string" value="clock">
      <property name="digital-layout" type="uint" value="3"/>
      <property name="digital-time-format" type="string" value="%H:%M"/>
    </property>
  </property>
</channel>
XML

# --- Start button: left click = menu, right click = Windows-X style menu ---
L="$PANEL/panel/launcher-7"
mkdir -p "$L"
cat > "$L/16000000007.desktop" <<'DESK'
[Desktop Entry]
Version=1.0
Type=Application
Name=Пуск
Comment=Меню LoriOS
Exec=xfce4-popup-whiskermenu
Icon=lorios-start
Terminal=false
StartupNotify=false
Actions=Taskmgr;Devmgr;Terminal;Files;Settings;Network;Logout;Restart;Shutdown;

[Desktop Action Taskmgr]
Name=Диспетчер задач
Exec=xfce4-taskmanager
Icon=utilities-system-monitor

[Desktop Action Devmgr]
Name=Диспетчер устройств
Exec=lorios-devmgr
Icon=computer

[Desktop Action Terminal]
Name=Терминал
Exec=xfce4-terminal
Icon=utilities-terminal

[Desktop Action Files]
Name=Проводник
Exec=thunar
Icon=system-file-manager

[Desktop Action Settings]
Name=Параметры
Exec=xfce4-settings-manager
Icon=preferences-system

[Desktop Action Network]
Name=Сетевые подключения
Exec=nm-connection-editor
Icon=network-wired

[Desktop Action Logout]
Name=Выйти из системы
Exec=xfce4-session-logout --logout
Icon=system-log-out

[Desktop Action Restart]
Name=Перезагрузка
Exec=xfce4-session-logout --reboot
Icon=system-reboot

[Desktop Action Shutdown]
Name=Завершение работы
Exec=xfce4-session-logout --halt
Icon=system-shutdown
DESK

# Device Manager wrapper: full info when sudo is passwordless (live session), basic info otherwise
mkdir -p config/includes.chroot/usr/local/bin
cat > config/includes.chroot/usr/local/bin/lorios-devmgr <<'BIN'
#!/bin/sh
if sudo -n true 2>/dev/null; then
  exec sudo -E lshw-gtk
else
  exec lshw-gtk
fi
BIN

# Keyboard shortcuts: Win = Start menu, Ctrl+Shift+Esc = Task Manager
cat > "$PANEL/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml" <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="custom" type="empty">
      <property name="Super_L" type="string" value="xfce4-popup-whiskermenu"/>
      <property name="&lt;Primary&gt;&lt;Shift&gt;Escape" type="string" value="xfce4-taskmanager"/>
      <property name="&lt;Super&gt;e" type="string" value="thunar"/>
    </property>
  </property>
</channel>
XML

cat > config/hooks/normal/0350-icons.hook.chroot <<'HOOK'
#!/bin/sh
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
HOOK

# --- Installer (Calamares): "Install LoriOS" on the desktop ---
cat > config/includes.chroot/etc/skel/Desktop/install-lorios.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=Install LoriOS
Name[ru]=Установить LoriOS
Comment=Установка LoriOS на диск
Exec=sudo -E calamares
Icon=system-software-install
Terminal=false
Categories=System;
DESK

cat > config/hooks/normal/0400-installer.hook.chroot <<'HOOK'
#!/bin/sh
# Make Calamares look like LoriOS (copy Debian branding, rename, swap logos)
for B in /etc/calamares/branding /usr/share/calamares/branding; do
  if [ -d "$B/debian" ]; then
    rm -rf "$B/lorios"
    cp -a "$B/debian" "$B/lorios"
    D="$B/lorios/branding.desc"
    sed -i -E 's/^([[:space:]]*(productName|shortProductName|versionedName|shortVersionedName|bootloaderEntryName):).*/\1 LoriOS/' "$D"
    sed -i -E 's/^componentName:.*/componentName:   lorios/' "$D"
    for key in productLogo productIcon productWelcome; do
      f=$(sed -n -E "s/^[[:space:]]*$key:[[:space:]]*\"?([^\"[:space:]]+)\"?.*/\1/p" "$D" | head -n1)
      if [ -n "$f" ] && [ -f "$B/lorios/$f" ]; then
        cp /usr/share/plymouth/themes/lorios/logo.png "$B/lorios/$f"
      fi
    done
    if [ -f /etc/calamares/settings.conf ]; then
      sed -i 's/^branding:.*/branding: lorios/' /etc/calamares/settings.conf
    fi
    break
  fi
done
# the live user that must be removed from the installed system
if [ -f /etc/calamares/modules/removeuser.conf ]; then
  sed -i 's/^username:.*/username: lori/' /etc/calamares/modules/removeuser.conf
fi
HOOK

# --- Branding ---
mkdir -p config/includes.chroot/etc
cat > config/includes.chroot/etc/os-release <<'REL'
PRETTY_NAME="LoriOS"
NAME="LoriOS"
ID=lorios
ID_LIKE=debian
REL
echo "LoriOS" > config/includes.chroot/etc/issue

# --- Locale ---
cat > config/hooks/normal/0100-locale.hook.chroot <<'HOOK'
#!/bin/sh
sed -i 's/# ru_RU.UTF-8/ru_RU.UTF-8/; s/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen
locale-gen
HOOK
chmod +x config/hooks/normal/*.hook.chroot

lb build

ISO="$(ls ./*.iso | head -n1)"
cp "$ISO" "${ISO%.iso}.img"   # hybrid-образ: .img записывается на флешку так же, как .iso
sha256sum "$ISO" > "${ISO%.iso}.sha256"
echo
ls -lh ./*.iso ./*.img
echo "Размер ISO: $(du -h "$ISO" | cut -f1)"
echo "Готово: ISO и IMG лежат в ~/lorios"

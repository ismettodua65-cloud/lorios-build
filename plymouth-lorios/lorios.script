Window.SetBackgroundTopColor(0.910, 0.922, 0.941);
Window.SetBackgroundBottomColor(0.910, 0.922, 0.941);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - Window.GetHeight() * 0.06);

FRAMES = 24;
for (i = 0; i < FRAMES; i++)
    spinner[i] = Image("spinner-" + i + ".png");

spin.sprite = Sprite(spinner[0]);
spin.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - spinner[0].GetWidth() / 2);
spin.sprite.SetY(Window.GetY() + Window.GetHeight() * 0.82);

progress = 0;
fun refresh_callback() {
    index = Math.Int(progress / 2) % FRAMES;
    spin.sprite.SetImage(spinner[index]);
    progress++;
}
Plymouth.SetRefreshFunction(refresh_callback);
